# ProRanked CPMS Console Starter — build-time config (Vite reads VITE_* at dev/build).
# These are FALLBACKS: a hosted deployment can instead overwrite /public/config.js at runtime (no rebuild).
# Copy to .env for local dev.

# ProRanked Identity issuer.
#   Lab:  https://id-lab.phevnix.cloud
#   Prod: https://id.proranked.com
VITE_OIDC_AUTHORITY=https://id.proranked.com

# Public PKCE client id.
#
# THE DEFAULT ONLY WORKS ON localhost. `proranked-cpms-spa` is a shared reference client whose
# allowed redirect URIs are fixed, and this app derives its redirect from window.location.origin —
# so deploying to your own domain with the default fails login with:
#     invalid_request / "The specified 'redirect_uri' is not valid for this client application."
#
# Before you deploy, register YOUR origin and use the client id it gives you:
#   app.proranked.com -> Settings -> OAuth clients -> Register
#     redirect URI      https://YOUR-DOMAIN/auth/callback
#     post-logout URI   https://YOUR-DOMAIN
#     app origin        https://YOUR-DOMAIN
#   You get back a client id like pr_spa_… — put it here.
#   (Allow up to a minute before first login: the new client propagates to the auth servers.)
VITE_OIDC_CLIENT_ID=proranked-cpms-spa

# Space-delimited operator scopes (CPO re-intersects with the operator's role).
VITE_OIDC_SCOPES=openid profile email offline_access cpms:read:chargers cpms:read:sessions cpms:read:analytics cpms:write:chargers cpms:command:chargers

# The CPMS resource the token targets (RFC 8707 audience) — must match Identity OperatorResource + CPO OAuth:Cpms:Audience.
VITE_OIDC_RESOURCE=https://api.proranked.com/cpms/v1

# Where the browser sends /cpms/v1 calls (the CPO host).
#   Lab:  https://cpo.phevnix.cloud
#   Prod: https://api.proranked.com
#   Local dev with the Vite proxy: leave empty.
VITE_CPMS_API_BASE=https://api.proranked.com
